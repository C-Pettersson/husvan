// Husvan data model (Prisma 6, Postgres 16).
//
// Read CLAUDE.md, section "Datamodell", before changing this file. The short
// version:
//   * Fixed core, dynamic facts. House and Component carry only what every
//     query needs. Everything Claude reads out of a document is an
//     Observation: key, value, who said it, which document, how sure.
//   * Append only. An Observation is never updated. A better value is a new
//     row; a wrong one gets retractedAt. A replaced component is a new
//     Component whose replacesId points at the old one.
//   * Drafts are real rows. Everything written through MCP belongs to a
//     Changeset. Rows in a DRAFT changeset exist in the tables but are
//     invisible to reads until the user approves. Approval flips one status.
//   * The authentication tables (user, session, account, verification, jwks,
//     oauth*) are owned by Better Auth. They were generated with
//     `npx auth generate --config src/lib/auth.ts` and are mapped to Better
//     Auth's own table names. When a Better Auth upgrade changes them,
//     regenerate into a scratch file and copy the models over; the CLI
//     rewrites the rest of this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication (Better Auth) ----------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  houses             House[]
  sessions           Session[]
  accounts           Account[]
  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]

  @@map("user")
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]              @default([])
  clientCredentialsScopes          String[]              @default([])
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]              @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]              @default([])
  postLogoutRedirectUris           String[]              @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]              @default([])
  responseTypes                    String[]              @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]              @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      Json?
  createdAt     DateTime?

  @@unique([clientId, resourceId], map: "oauthClientResource_clientId_resourceId_uidx")
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]           @default([])
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]           @default([])

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]    @default([])
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// Reference data per municipality ---------------------------------------------

model Municipality {
  code               String   @id // SCB municipality code, four digits
  name               String
  groundSnowLoadKnM2 Decimal? @db.Decimal(4, 2) // snow zone value, Boverket
  fgeo               Decimal? @db.Decimal(3, 2) // geographic adjustment factor, BBR
  dvutC              Decimal? @db.Decimal(4, 1) // design winter outdoor temperature
  cloudburstMapUrl   String?
  updatedAt          DateTime @updatedAt

  houses            House[]
  tariffChanges     MunicipalTariffChange[]
  taxRates          MunicipalTaxRate[]
  leaseholdPolicies LeaseholdPolicy[]
}

// Municipal and regional income tax rate per year, from SCB's yearly table of
// all municipalities. Used only when the user has set a household income.
model MunicipalTaxRate {
  municipalityCode String
  year             Int
  municipalRate    Decimal @db.Decimal(6, 4) // 0.2250 = 22.50 %
  regionalRate     Decimal @db.Decimal(6, 4)
  sourceUrl        String?

  municipality Municipality @relation(fields: [municipalityCode], references: [code])

  @@id([municipalityCode, year])
}

// How a municipality sells leasehold land (tomträtt) for small houses to the
// leaseholder (friköp). Curated from each municipality's own pages; there is
// no national source. The policy in force on a date is the newest validFrom
// before it. Applies only when the municipality is the lessor.
model LeaseholdPolicy {
  id               String                @id @default(uuid(7)) @db.Uuid
  municipalityCode String
  validFrom        DateTime              @db.Date
  buyoutMethod     LeaseholdBuyoutMethod
  buyoutFactor     Decimal?              @db.Decimal(4, 3) // 0.700 = 70 % of the land assessment value
  sourceUrl        String
  note             String? // conditions, e.g. 'only on the first day of a quarter'

  municipality Municipality @relation(fields: [municipalityCode], references: [code])

  @@unique([municipalityCode, validFrom])
}

enum LeaseholdBuyoutMethod {
  LAND_ASSESSMENT_SHARE // buyoutFactor x marktaxeringsvärde
  MARKET_VALUE // valued case by case, no formula
  NOT_OFFERED
}

// Year-on-year change per municipality and cost category, from the Nils
// Holgersson report. Used only when the user turns on operating cost trends.
model MunicipalTariffChange {
  municipalityCode String
  year             Int
  category         TariffCategory
  changeFraction   Decimal        @db.Decimal(6, 4) // 0.079 = +7.9 %
  sourceUrl        String?

  municipality Municipality @relation(fields: [municipalityCode], references: [code])

  @@id([municipalityCode, year, category])
}

enum TariffCategory {
  WATER_SEWAGE
  WASTE
  ELECTRICITY
  DISTRICT_HEATING
}

// National price index series, used to bring library prices from their price
// year to the forecast start year. series: 'bki_small_houses' (SCB
// construction cost index for group-built small houses, monthly).
model PriceIndex {
  series    String
  period    DateTime @db.Date // first day of the month
  value     Decimal  @db.Decimal(12, 4)
  sourceUrl String?

  @@id([series, period])
}

// National tax rules that change by year. The forecast uses the newest year
// up to the start year. Keys are validated in code:
// property_fee_rate (0.0075), property_fee_cap_sek (cap per small house),
// property_fee_exempt_years (15), property_fee_exempt_from_value_year (2012),
// title_stamp_duty_rate (0.015), title_fee_sek (825),
// mortgage_deed_stamp_duty_rate (0.02), mortgage_deed_fee_sek (375),
// interest_deduction_rate (0.30), interest_deduction_reduced_rate (0.21),
// interest_deduction_limit_sek (100000, per borrower).
model TaxParameter {
  key       String
  year      Int
  value     Decimal @db.Decimal(14, 4)
  sourceUrl String

  @@id([key, year])
}

// Type library ----------------------------------------------------------------

model ComponentType {
  type                 String   @id // snake_case key, e.g. underfloor_heating
  label                Json // {"sv": "Golvvärme", "en": "Underfloor heating"}
  category             String // heating, ventilation, roof, ...
  attributeSchema      Json     @default("{}") // key -> {label, datatype, unit, options}
  allowedSubcomponents String[] @default([])
  // Per-type overrides for the forecast rules in CLAUDE.md, e.g.
  // {"quantityPerLivingM2": 0.15, "conditionRule": {"5": "max", "2": "min"}}
  forecastDefaults     Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  components       Component[]
  lifespanProfiles LifespanProfile[]
}

// Lifespan and cost for a type, optionally narrowed to attribute values
// (match = {"material": "clay_tile"}). The forecast picks the most specific
// matching profile. The numbers are the curated result; sources keeps the
// raw values per source for traceability:
// [{"name": "Handelsbanken", "url": ..., "lifespanYears": 40, "costSek": 1200, "note": ...}]
model LifespanProfile {
  id                   String   @id @default(uuid(7)) @db.Uuid
  type                 String
  match                Json     @default("{}")
  lifespanMinYears     Int
  lifespanTypicalYears Int
  lifespanMaxYears     Int
  costLowSek           Decimal? @db.Decimal(12, 0)
  costHighSek          Decimal? @db.Decimal(12, 0)
  costUnit             CostUnit
  priceYear            Int?
  // Repainting of painted wood, a recurring cost apart from replacement, in
  // the same costUnit and priceYear. Null when the part is not repainted.
  // A known paint_type uses the interval in the type's forecastDefaults.
  repaintMinYears      Int?
  repaintTypicalYears  Int?
  repaintMaxYears      Int?
  repaintCostLowSek    Decimal? @db.Decimal(12, 0)
  repaintCostHighSek   Decimal? @db.Decimal(12, 0)
  sources              Json     @default("[]")

  componentType ComponentType @relation(fields: [type], references: [type])

  @@index([type])
}

// costUnit decides which observation key gives the quantity (see CLAUDE.md):
// M2 -> area, LINEAR_M -> length, EACH -> quantity (default 1), HOUSE -> 1.
enum CostUnit {
  EACH
  M2
  LINEAR_M
  HOUSE
}

// Changesets ------------------------------------------------------------------

// Every row written through MCP or the web points at a changeset. Reads
// include a row only when its changeset is APPROVED. Draft rows are shown
// to the user as the proposal to approve or reject.
model Changeset {
  id        String          @id @default(uuid(7)) @db.Uuid
  status    ChangesetStatus @default(DRAFT)
  source    ValueSource
  houseId   String?         @db.Uuid // null = not about one house (default assumptions)
  comment   String?
  createdAt DateTime        @default(now())
  decidedAt DateTime?

  house        House?        @relation(fields: [houseId], references: [id])
  components   Component[]
  observations Observation[]
  documents    Document[]
  workItems    WorkItem[]
  assumptions  Assumption[]

  @@index([houseId, status])
}

enum ChangesetStatus {
  DRAFT
  APPROVED
  REJECTED
}

// Who asserted a value. The document it came from is documentId; the kind of
// document (inspection, listing) is Document.type, not a source.
enum ValueSource {
  USER
  CLAUDE
  IMPORT
}

// Houses ----------------------------------------------------------------------

model House {
  id                  String      @id @default(uuid(7)) @db.Uuid
  ownerId             String
  address             String
  municipalityCode    String?
  propertyDesignation String? // fastighetsbeteckning
  status              HouseStatus @default(CANDIDATE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  municipality Municipality? @relation(fields: [municipalityCode], references: [code])
  changesets   Changeset[]
  components   Component[]
  observations Observation[]
  documents    Document[]
  workItems    WorkItem[]
  assumptions  Assumption[]
  forecasts    Forecast[]

  @@index([ownerId])
}

// Where the house stands for the owner. The sale itself (upcoming, bidding,
// closed) is the observation sale_status, since it comes from the listing and
// the broker and can be wrong.
enum HouseStatus {
  CANDIDATE
  DECLINED
  PURCHASED
  SOLD
}

// Documents and actors --------------------------------------------------------

// save_document stores text, metadata and Claude's interpretation. The
// original file is uploaded through the web app (MCP calls carry JSON) and
// matched to the row by sha256, which fills storagePath.
model Document {
  id             String       @id @default(uuid(7)) @db.Uuid
  houseId        String?      @db.Uuid // null until the house exists
  type           DocumentType
  title          String?
  sourceUrl      String? // e.g. the listing URL
  filename       String?
  mime           String?
  sha256         String?      @unique
  storagePath    String? // null until the file is uploaded
  fullText       String?
  interpretation Json? // Claude's interpretation, stored unchanged
  documentDate   DateTime?    @db.Date
  amountSek      Decimal?     @db.Decimal(12, 2)
  actorId        String?      @db.Uuid
  changesetId    String       @db.Uuid
  createdAt      DateTime     @default(now())

  house        House?        @relation(fields: [houseId], references: [id])
  actor        Actor?        @relation(fields: [actorId], references: [id])
  changeset    Changeset     @relation(fields: [changesetId], references: [id])
  observations Observation[]
  workItems    WorkItem[]

  @@index([houseId])
}

enum DocumentType {
  LISTING
  INSPECTION
  PIPE_INSPECTION // rörinspektion, usually a filmed sewer line
  ELECTRICAL_INSPECTION // elbesiktning
  ENERGY_CERTIFICATE
  INVOICE
  RECEIPT
  MANUAL
  WARRANTY
  DRAWING
  PHOTO
  OTHER
}

model Actor {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  orgNumber String? // organisationsnummer
  roles     String[] @default([]) // installer, supplier, manufacturer, broker, inspector
  contact   Json     @default("{}")

  documents Document[]
}

// Components in a tree --------------------------------------------------------

model Component {
  id          String   @id @default(uuid(7)) @db.Uuid
  houseId     String   @db.Uuid
  type        String
  parentId    String?  @db.Uuid
  replacesId  String?  @db.Uuid // this component replaced that one
  name        String? // e.g. 'W-3, kitchen, south'
  changesetId String   @db.Uuid
  createdAt   DateTime @default(now())

  house         House         @relation(fields: [houseId], references: [id])
  componentType ComponentType @relation(fields: [type], references: [type])
  parent        Component?    @relation("ComponentTree", fields: [parentId], references: [id])
  children      Component[]   @relation("ComponentTree")
  replaces      Component?    @relation("ComponentReplacement", fields: [replacesId], references: [id])
  replacedBy    Component[]   @relation("ComponentReplacement")
  changeset     Changeset     @relation(fields: [changesetId], references: [id])
  observations  Observation[]
  workItems     WorkItem[]

  @@index([houseId])
  @@index([parentId])
  @@index([replacesId])
}

// Observations: every fact about a house or component -------------------------

// One row per assertion. Several rows may exist for the same key: the listing
// says the roof is from 1995, the inspection says 2001, the user says 1998.
// The current value is chosen on read: USER first, then highest confidence,
// then newest. A row is never updated; retractedAt hides it.
model Observation {
  id          String      @id @default(uuid(7)) @db.Uuid
  houseId     String      @db.Uuid
  componentId String?     @db.Uuid // null = about the house itself
  key         String // snake_case, e.g. installation_year
  value       Json
  unit        String?
  source      ValueSource
  documentId  String?     @db.Uuid
  confidence  Decimal?    @db.Decimal(3, 2) // 0.00 to 1.00
  quote       String? // the passage in the document that supports the value
  retractedAt DateTime?
  changesetId String      @db.Uuid
  recordedAt  DateTime    @default(now())

  house     House      @relation(fields: [houseId], references: [id])
  component Component? @relation(fields: [componentId], references: [id])
  document  Document?  @relation(fields: [documentId], references: [id])
  changeset Changeset  @relation(fields: [changesetId], references: [id])

  @@index([houseId, componentId, key])
  @@index([changesetId])
}

// Work items: what the inspection or the user says needs doing ----------------

// Append only like observations: a work item that is wrong or that the user
// dismisses gets retractedAt. Done work belongs to maintenance mode and is
// added with its own table then.
// The protocol's levels: MINOR mindre brist or a note, RISK a risk in the
// risk analysis, DEFECT a defect to fix, SEVERE a serious defect or damage.
enum WorkItemSeverity {
  MINOR
  RISK
  DEFECT
  SEVERE
}

model WorkItem {
  id          String       @id @default(uuid(7)) @db.Uuid
  houseId     String       @db.Uuid
  componentId String?      @db.Uuid
  kind        WorkItemKind
  // How serious the inspection judged it, in the protocol's own terms;
  // times an item without years.
  severity    WorkItemSeverity?
  description String
  yearMin     Int? // "within 1 to 3 years" becomes a range
  yearMax     Int?
  costLowSek  Decimal?     @db.Decimal(12, 0)
  costHighSek Decimal?     @db.Decimal(12, 0)
  source      ValueSource
  documentId  String?      @db.Uuid
  quote       String?
  retractedAt DateTime?
  // This work item restates that one, e.g. with a cost estimate; the old
  // row is untouched and hidden when read.
  replacesId  String?      @db.Uuid
  changesetId String       @db.Uuid
  createdAt   DateTime     @default(now())

  house      House      @relation(fields: [houseId], references: [id])
  component  Component? @relation(fields: [componentId], references: [id])
  document   Document?  @relation(fields: [documentId], references: [id])
  changeset  Changeset  @relation(fields: [changesetId], references: [id])
  replaces   WorkItem?  @relation("WorkItemReplacement", fields: [replacesId], references: [id])
  replacedBy WorkItem[] @relation("WorkItemReplacement")

  @@index([houseId])
  @@index([replacesId])
}

// REPLACEMENT of a component takes the place of that component's term in the
// maintenance debt, so it is never counted twice. INVESTIGATION is a
// recommended survey, e.g. "film the sewer line" or "measure moisture".
enum WorkItemKind {
  REPLACEMENT
  REPAIR
  INVESTIGATION
}

// Area statistics -------------------------------------------------------------

// Statistics that apply to many houses, imported per area and level (Brå, SCB).
// A house reaches its areas through its municipality and the observations
// deso_code and police_area_code. NATION has areaCode 'SE' and is the
// comparison value shown next to every figure.
model AreaStatistic {
  areaLevel  AreaLevel
  areaCode   String // municipality code, DeSO code, police area id or 'SE'
  key        String // snake_case, e.g. reported_crimes_per_100k
  year       Int
  value      Decimal   @db.Decimal(14, 4)
  unit       String?
  source     String // e.g. bra, bra_ntu, scb
  sourceUrl  String?
  importedAt DateTime  @default(now())

  @@id([areaLevel, areaCode, key, year])
}

enum AreaLevel {
  NATION
  MUNICIPALITY
  POLICE_AREA
  DESO
}

// Forecast assumptions --------------------------------------------------------

// Append only; the newest approved row per (houseId, key) wins. houseId null
// is the default for all houses. Keys and their value shapes are validated in
// code: horizon_years, start_year, interest_rate, loan_sek, borrower_count,
// electricity_price_sek_kwh, district_heating_price_sek_kwh,
// operating_cost_trend ('none' | 'municipality'), household_income_sek,
// leasehold_buyout_year (null = keep the leasehold).
model Assumption {
  id          String   @id @default(uuid(7)) @db.Uuid
  houseId     String?  @db.Uuid
  key         String
  value       Json
  changesetId String   @db.Uuid
  createdAt   DateTime @default(now())

  house     House?    @relation(fields: [houseId], references: [id])
  changeset Changeset @relation(fields: [changesetId], references: [id])

  @@index([houseId, key])
}

// Saved forecasts, to see how the assessment of a house changes ---------------

model Forecast {
  id           String   @id @default(uuid(7)) @db.Uuid
  houseId      String   @db.Uuid
  calculatedAt DateTime @default(now())
  assumptions  Json // the assumptions that were used
  result       Json // cost per year and item, total, range, missing inputs

  house House @relation(fields: [houseId], references: [id])

  @@index([houseId, calculatedAt])
}
