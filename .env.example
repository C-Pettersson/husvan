# Local Postgres from docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL=postgresql://husvan:husvan@localhost:5433/husvan?schema=public

# Public origin of the app. The OAuth issuer and the MCP resource
# (`${BETTER_AUTH_URL}/api/mcp`) are derived from it, so it must be the address
# Claude reaches: http://localhost:3000 for local work, https://dev.husvan.se
# through the Cloudflare Tunnel, https://husvan.se in production.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The owner, created by `yarn db:seed` as ADMIN and put on the allowlist.
# Sign-up is disabled; other users are added on /admin and sign in with a
# login link. SEED_USER_PASSWORD is optional: set, it keeps an email and
# password login as a fallback; empty, the owner signs in with a link only.
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=

# Login links go out over SMTP through Cloudflare Email Service: host
# smtp.mx.cloudflare.net, port 465 (implicit TLS), username api_token and an
# API token with the "Email Sending: Edit" permission as password. MAIL_FROM
# must be an address on a domain enabled for sending there. Leave SMTP_TOKEN
# empty locally: the mail is then printed to the terminal instead of sent. In
# production it is required.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_TOKEN=
MAIL_FROM=noreply@husvan.se

# Cloudflare Turnstile in front of the login form (both the link request and
# the password login). Empty: no widget and no check. The values below are
# Cloudflare's test keys, which always pass; production uses the widget
# registered for husvan.se (site key 0x4AAAAAAFxKVCb25d3sy6Ys) and its secret.
# In production the server also requires action "login" and a hostname from
# TURNSTILE_HOSTNAMES (comma-separated; unset, the host of BETTER_AUTH_URL).
# Locally those checks are off unless TURNSTILE_HOSTNAMES is set, since the
# test keys answer with hostname example.com.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=

# Document file storage on Cloudflare R2, through its S3-compatible API.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=husvan-dev
STORAGE_PREFIX=dev/
