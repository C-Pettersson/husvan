# Local Postgres from docker-compose.yml (`docker compose up -d postgres`).
DATABASE_URL=postgresql://husvan:husvan@localhost:5433/husvan?schema=public

# Public origin of the app. The OAuth issuer and the MCP resource
# (`${BETTER_AUTH_URL}/api/mcp`) are derived from it, so it must be the address
# Claude reaches: http://localhost:3000 for local work, https://dev.husvan.se
# through the Cloudflare Tunnel, https://husvan.se in production.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 random characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The one user, created by `yarn db:seed`. Sign-up is disabled.
SEED_USER_EMAIL=
SEED_USER_NAME=
SEED_USER_PASSWORD=

# Document file storage on Cloudflare R2, through its S3-compatible API.
# Endpoint: https://<account-id>.r2.cloudflarestorage.com
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=husvan-dev
STORAGE_PREFIX=dev/
